{
  "name": "toonflow",
  "description": "Laywork 是一款开源 AI 创作工具，用无限画布和 Agent 助手组织文字、图片、视频、音频与自定义节点。",
  "author": "HBAI-Ltd <ltlctools@outlook.com>",
  "license": "MIT",
  "homepage": "https://github.com/1797127235/Toonflow-app#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1797127235/Toonflow-app.git"
  },
  "bugs": {
    "url": "https://github.com/1797127235/Toonflow-app/issues",
    "email": "ltlctools@outlook.com"
  },
  "type": "module",
  "packageManager": "bun@1.3.14",
  "patchedDependencies": {
    "@vue-flow/core@1.48.2": "patches/vueFlowCore.patch"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/nodes/*",
    "packages/tools/*",
    "packages/teams/*",
    "packages/ext/*"
  ],
  "scripts": {
    "dev": "TOONFLOW_HOST=desktop bun run dev:server & bun run dev:web & wait",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:server": "bun run --cwd apps/server dev",
    "dev:desktop": "bun apps/desktop/scripts/build.ts dev",
    "dev:plugins": "bun scripts/workspaceTasks.ts build plugins --dev",
    "dev:updateServer": "bun run --filter '@toonflow/updateServer' dev",
    "start:updateServer": "bun run --filter '@toonflow/updateServer' start",
    "publish:update": "bun run apps/updateServer/scripts/publish.ts",
    "start:server": "bun run --cwd apps/server start",
    "build:server": "bun apps/server/scripts/buildStandalone.ts",
    "build": "bun run build:tools && bun run build:ext && bun run --filter '@toonflow/web' --filter '@toonflow/server' build",
    "build:nodes": "bun scripts/workspaceTasks.ts build nodes",
    "create:ext": "bun packages/extScaffold/create.ts",
    "build:ext": "bun scripts/workspaceTasks.ts build ext",
    "build:desktop": "bun apps/desktop/scripts/build.ts build",
    "build:mcp": "bun run --filter '@toonflow/mcp' build",
    "build:teams": "bun scripts/workspaceTasks.ts build teams",
    "package:desktop": "bun apps/desktop/scripts/build.ts package",
    "release:desktop": "bun run apps/desktop/scripts/release.ts",
    "typecheck": "bun scripts/workspaceTasks.ts typecheck",
    "build:tools": "bun scripts/workspaceTasks.ts build tools"
  },
  "devDependencies": {
    "@toonflow/file": "workspace:*",
    "@types/bun": "^1.4.2",
    "@types/postcss-pxtorem": "^6.1.0",
    "postcss": "^8.5.28",
    "postcss-pxtorem": "^6.1.0",
    "typescript": "^7.0.2"
  }
}
